<?xml version="1.0" encoding="UTF-8"?>
<!--
  A distinct x86 variant so the Watcom compiler spec can be selected without
  modifying the read-only Ghidra installation.  Reuses the stock x86 sleigh
  language and processor spec; the calling convention differs, and the sleigh
  language is a copy (x86f.sla, made by install.sh) in which every store of a
  float (FST / FSTP to a 32- or 64-bit place) is shown as f32() / f64():
  the stock decompiler prints a sum that is stored and read back as one
  expression, and the rounding of the store is lost.
-->
<language_definitions>
  <language processor="x86"
            endian="little"
            size="32"
            variant="watcom"
            version="4.7"
            slafile="x86f.sla"
            processorspec="x86.pspec"
            id="x86:LE:32:watcom">
    <description>Intel/AMD 32-bit x86 (Watcom C/C++ register convention)</description>
    <compiler name="Watcom" spec="x86watcom.cspec" id="watcom"/>
    <external_name tool="gnu" name="i386:intel"/>
    <external_name tool="IDA-PRO" name="metapc"/>
  </language>
</language_definitions>
